{
  "expo": {
    "name": "Cricket Tosser",
    "slug": "cricket-tosser",
    "version": "2.14.0",
    "scheme": "cricket-tosser",
    "orientation": "portrait",
    "icon": "./assets/images/APP_ICON_MAIN_WITH_BORDERS.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#f1ead8",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.crickettosser.app",
      "deploymentTarget": "16.4",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "splash": {
        "backgroundColor": "#f1ead8",
        "resizeMode": "contain"
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/APP_ICON_MAIN_WITH_BORDERS.png",
        "backgroundColor": "#a8331f"
      },
      "package": "com.crickettosser.app",
      "versionCode": 15,
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "cricket-tosser"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/images/APP_ICON_MAIN_WITH_BORDERS.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f1ead8",
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "android": {
            "backgroundColor": "#f1ead8",
            "image": "./assets/splash-icon.png",
            "resizeMode": "contain"
          }
        }
      ],
      "./plugins/fixSplashScreen",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "PitchReader needs your location to fetch live weather conditions at your cricket ground.",
          "locationWhenInUsePermission": "PitchReader needs your location to fetch live weather conditions at your cricket ground."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Cricket Tosser needs access to your photos to select pitch photos.",
          "savePhotosPermission": "Cricket Tosser needs access to save photos.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": [],
          "microphone": false
        }
      ],
      "expo-file-system",
      "./plugins/scopeLegacyStoragePermissions",
      [
        "expo-camera",
        {
          "cameraPermission": "Cricket Tosser needs camera access to photograph the pitch."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/APP_ICON_MAIN_WITH_BORDERS.png",
          "color": "#104020",
          "androidMode": "default",
          "iosDisplayInForeground": true
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "9048bacd-f000-49b5-8512-15f44f8b3814"
      }
    }
  }
}
